[user]
	email = frederick.tyteca@actualgroup.com
	name = frederick tyteca
[pager]
	branch = false
[core]
	pager = cat
	excludesfile = /home/fred/.gitignore
[pull]
	rebase = false
[init]
	defaultBranch = main
[credential]
	helper = store
[credential "https://github.com"]
	username = ftytecaActual
[credential "https://api.github.com"]
	username = ftytecaActual
[alias]
	gone = "!git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs -r git branch -d"
[push]
	autoSetupRemote = true
# Machine-specific settings (safe.directory, user.email override...) live in an
# unversioned ~/.gitconfig.local. Keep this last so it can override the above.
[include]
	path = ~/.gitconfig.local
